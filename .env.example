# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# EmanuelCatania/Mu-Linux (MySQL 8.4 MuOnline97) Connection Settings
# Leave DB_HOST empty to run in local MuOnline97-compatible preview mode.
# When deployed alongside Mu-Linux docker-compose.yml, set DB_HOST=mysql.
# ==============================================================================
DB_HOST=""
DB_PORT="3306"
DB_USER="admin"
DB_PASS=""
DB_NAME="MuOnline97"

# Mu-Linux Server TCP Probes (ConnectServer.ini & ServerList.dat defaults)
CS_HOST="127.0.0.1"
CS_PORT="44405"
GS_HOST="127.0.0.1"
GS_PORT="55901"

# Portal Session & Cooldown Settings (matches Mu-Linux web/server.js)
SESSION_SECRET="replace-with-strong-random-secret"
ACTION_COOLDOWN_MINUTES="3"
